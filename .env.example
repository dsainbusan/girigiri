# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. 실제 값을 여기(.env.example)에 채우지 마세요.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/girigiri?useSSL=false&serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

# --- 아래 값들은 아직 애플리케이션 코드에 연동되어 있지 않습니다.
# --- CLAUDE.md의 Phase 1/3 작업이 진행될 때 실제 값으로 채워질 예정입니다.
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_MAP_API_KEY=
# PORTONE_API_KEY=
# PORTONE_MERCHANT_ID=
